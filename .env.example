# Public client configuration only. Copy this file to .env for local development.
# Get these values from your own Supabase project; never use service_role or secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public pages linked from Settings. Optional while the pages are being written:
# Settings shows them as "coming soon". Set real https pages before a store build.
EXPO_PUBLIC_SUPPORT_URL=https://your-domain.example/support
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy

# GEMINI_API_KEY belongs in Supabase Edge Function secrets, never in this file
# or in any EXPO_PUBLIC_ variable.
